#!/bin/bash -p
# -p (privileged mode): ignore SHELLOPTS, BASHOPTS, ENV and exported functions from the
# caller, so tracing or function overrides cannot run inside this engine.
# secrets-exec — run a named, allowlisted consumer with a vault secret injected into
# its environment, without the value ever entering the caller's context.
#
#   secrets-exec <consumer> [args...]     e.g.  secrets-exec github-read /user
#   secrets-exec --list                   show registered consumers
#
# WHY THIS EXISTS
# ---------------
# Agents need a way to use credentials without placing their values in tool output
# or conversation transcripts. A named, reviewed consumer can use a credential on
# the caller's behalf without returning the credential itself.
#
# WHAT THIS IS, AND WHAT IT IS NOT
# --------------------------------------------------------------------------------
# This is LEAK-REDUCTION. It is NOT containment.
#
# Concretely, it defends against: the value reaching the model's context, a transcript,
# a log, the process table, or a shell history — i.e. against accident, and against a
# single careless or manipulated tool call.
#
# It does NOT defend against an adversary who already has the agent's shell. This wrapper,
# the registry, and the consumers.d scripts are all files owned by the same OS user the
# agent runs as, so that user can edit them. Fixed configuration paths prevent caller
# redirection but do not create a privilege boundary. Real containment needs the broker
# to run as a DIFFERENT principal (ideally on the key-holding host) with no general SSH
# access from the agent.
#
# THE PROPERTIES THAT DO HOLD
# ---------------------------
# 1. The caller names a CONSUMER, not a secret. It cannot ask for an arbitrary bundle/key,
#    so it cannot be turned into a general vault reader.
# 2. The caller supplies ARGUMENTS, not the command. The command comes from the registry,
#    so the caller cannot substitute `env` for the registered program.
# 3. The value is fetched over ssh into a shell variable, exported, and never printed or
#    written to disk. It IS unavoidably present in the environment of the child process —
#    that is how env-based auth works — so property 3 is only as good as the registered
#    PROGRAM. See the registry header: choosing a consumer is the security decision.
#
#    Never use `env -i VAR=val cmd`: that puts the assignment in argv, readable through
#    the process table. Instead export inside this shell and start the command as a
#    child, so its exit status can be audited. Inherited runtime hooks are scrubbed
#    below; this is still not a separate-user security boundary.
set -uo pipefail
umask 077

# ── fixed configuration — deliberately NOT caller-overridable ─────────────────
# Registry, audit and remote configuration must not be selected by caller environment
# overrides: a caller could otherwise name a bundle/key and choose its own program to
# receive the credential. Fixed paths prevent this redirection without claiming to
# stop the same OS user from editing installed files.
# HOME is a caller input (`env HOME=/tmp/x secrets-exec ...` changes it), so a HOME-derived
# path would be a caller-selected registry or audit sink. Use this script's location: it lives at
# <home>/bin/secrets-exec, so <home> is its parent directory. A caller cannot move that
# without editing the wrapper, at which point every guarantee here is moot anyway.

# ── fixed PATH ────────────────────────────────────────────────────────────────
# Pinned before the FIRST external command (including the dirname calls that locate the
# registry): a caller PATH with its own `dirname` could otherwise move the registry. Every
# external helper below runs from here, so the caller cannot influence which
# ssh/grep/sed/tr implementation we end up executing.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

# Internal wrapper controls are consumed with builtins before any program starts.
# Unexport the captures too: imported names can otherwise keep their export attribute.
_metadata_requested="${SECRETS_EXEC_METADATA:-0}"
_call_id_input="${SECRETS_EXEC_CALL_ID:-}"
_call_id_present="${SECRETS_EXEC_CALL_ID+x}"
unset SECRETS_EXEC_METADATA SECRETS_EXEC_CALL_ID
export -n _metadata_requested _call_id_input _call_id_present

reserved_env() {
  # Keep explicit proxy names for clarity; the suffix globs already cover them.
  # shellcheck disable=SC2221,SC2222
  case "$1" in
    call_id|_metadata_*|_call_id_*|_invalid_call_id|SECRETS_EXEC_*|\
    PATH|HOME|IFS|ENV|BASH_ENV|SHELLOPTS|BASHOPTS|PS4|CDPATH|GLOBIGNORE|LD_*|DYLD_*|BASH_FUNC_*|BASH_XTRACEFD|\
    CURL_HOME|SSL_CERT_FILE|SSL_CERT_DIR|CURL_CA_BUNDLE|SSLKEYLOGFILE|OPENSSL_*|\
    *_PROXY|*_proxy|ALL_PROXY|all_proxy|NO_PROXY|no_proxy|\
    GCONV_PATH|GLIBC_TUNABLES|LOCPATH|NLSPATH|MALLOC_*|XDG_*|TMPDIR|TMP|TEMP|\
    GIT_*|GODEBUG|GOFLAGS|GOTRACEBACK|GOENV|\
    JAVA*|_JAVA_OPTIONS|JDK_JAVA_OPTIONS|NODE*|PYTHON*|PERL*|RUBY*)
      return 0 ;;
  esac
  return 1
}

# Drop reserved variables that are valid shell names (LD_PRELOAD, proxies, CA bundles, ...)
# from this shell's environment before any external program runs, so no program started by
# the engine (ssh, env, the consumer) loads a caller-chosen library or proxy. Names bash
# cannot unset (exported functions such as BASH_FUNC_printf%%) are removed per program below.
for _n in $(compgen -e); do
  # Unexport the variable named by _n, not _n itself.
  # shellcheck disable=SC2163
  case "$_n" in
    PATH|HOME) continue ;;
    # bash specials: unexport only. `unset BASH_XTRACEFD` closes that descriptor (stdout/stderr
    # when it is 1/2), and SHELLOPTS/BASHOPTS are readonly.
    BASH_XTRACEFD|SHELLOPTS|BASHOPTS) export -n "$_n" ;;
    *) if reserved_env "$_n"; then unset "$_n"; fi ;;
  esac
done
unset _n

_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_HOME="$(dirname "$_SELF")"
CONF="$AGENT_HOME/.config/secrets-exec/consumers.conf"
AUDIT="$AGENT_HOME/.config/secrets-exec/audit.log"
# Where values come from: an ssh destination plus two remote command templates, read from a
# file next to the registry (same trust: whoever can write it can already edit the registry).
# Loaded only when a value or a key listing is actually needed, so refusals never depend on it.
BACKEND="$AGENT_HOME/.config/secrets-exec/backend.conf"
REMOTE=""; GET_T=""; LIST_T=""

# Linux supplies a fresh opaque ID without an external helper or caller-selected input.
IFS= read -r call_id < /proc/sys/kernel/random/uuid || {
  printf 'secrets-exec: cannot generate internal call ID\n' >&2; exit 1;
}
_invalid_call_id=0
if [ "$_call_id_present" = x ]; then
  if [[ "$_call_id_input" =~ ^[A-Za-z0-9._-]{1,96}$ ]]; then call_id="$_call_id_input";
  else _invalid_call_id=1; fi
fi
unset _call_id_input _call_id_present
readonly call_id
_metadata_sent=0
_metadata_bundle=''
_metadata_keys=''
emit_metadata() {
  [ "$_metadata_requested" = 1 ] && [ "$_metadata_sent" = 0 ] || return 0
  _metadata_sent=1
  # Only names enter argv. Isolated Python ignores import hooks and site initialization.
  /usr/bin/python3 -I -S -B -c 'import json, sys
cid, consumer, bundle, keys = sys.argv[1:]
source = {"consumer": consumer, "bundle": bundle, "key_names": keys.split("+")} if bundle else None
print("SECRETS_EXEC_META_V1 " + json.dumps({"schema": "secrets-exec/metadata/1", "call_id": cid, "consumer": consumer, "credential_source": source}, separators=(",", ":")))' \
    "$call_id" "${name:-none}" "$_metadata_bundle" "$_metadata_keys"
}

load_backend() {
  [ -f "$BACKEND" ] || refuse "no backend at $BACKEND — nothing can be fetched (fail closed)"
  local l k seen=" "
  while IFS= read -r l || [ -n "$l" ]; do
    case "$l" in ''|\#*) continue ;; esac
    k="${l%%=*}"
    case "$k" in host|get|list) ;; *) refuse "malformed line in $BACKEND (allowed keys: host, get, list)" ;; esac
    case "$seen" in *" $k "*) refuse "duplicate '$k' in $BACKEND" ;; esac
    seen="$seen$k "
    case "$k" in
      host) REMOTE="${l#host=}" ;;
      get)  GET_T="${l#get=}" ;;
      list) LIST_T="${l#list=}" ;;
    esac
  done < "$BACKEND"
  # The host cannot start with '-' (it would be read as an ssh option). Templates are plain
  # command words: no quotes, no shell metacharacters; bundle and key are inserted quoted.
  local host_rx='^[A-Za-z0-9][A-Za-z0-9._@-]*$' tmpl_rx='^[A-Za-z0-9_./~{} -]+$'
  [[ "$REMOTE" =~ $host_rx ]] || refuse "backend host is missing or invalid in $BACKEND"
  [[ "$GET_T" =~ $tmpl_rx ]] && [[ "$GET_T" == *"{bundle}"*"{key}"* ]] \
    || refuse "backend 'get' is missing or invalid in $BACKEND (needs {bundle} then {key}; plain words only)"
  [[ "$LIST_T" =~ $tmpl_rx ]] && [[ "$LIST_T" == *"{bundle}"* ]] \
    || refuse "backend 'list' is missing or invalid in $BACKEND (needs {bundle}; plain words only)"
}

remote_cmd() { # remote_cmd <template> <bundle> [key] -> template with quoted bundle/key
  local t="$1" qb="'$2'" qk="'${3:-}'"
  t="${t//"{bundle}"/$qb}"; t="${t//"{key}"/$qk}"
  printf '%s' "$t"
}


# ── audit ─────────────────────────────────────────────────────────────────────
# Records names and arguments, never fetched values. Refusals matter as well as successful
# fetches: near misses must be visible. Returns non-zero if the record could not be written.
audit() { # audit <outcome> <detail...>
  # Record ALL detail arguments: callers pass bundle/key/cmd separately, and silently
  # dropping any of them would leave an apparently complete but misleading audit trail.
  local outcome="$1"; shift
  local detail="$*"
  {
    # Prefer util-linux; isolated stdlib Python is the fallback when it is absent.
    # The shared open-file description keeps either lock until descriptor 9 closes.
    if [ -x /usr/bin/flock ]; then
      /usr/bin/flock -x 9 || return 1
    else
      /usr/bin/python3 -I -S -B -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX)' || return 1
    fi
    {
      # via= is the basename this engine was invoked through (a same-dir alias logs its own
      # name, so leftover callers of a retired name are countable). Both consumer and
      # basename are caller-controlled: %q keeps each record on exactly one line.
      printf '%s outcome=%s consumer=%q call_id=%s %s via=%q args=' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$outcome" "${name:-none}" "$call_id" "$detail" "${0##*/}"
      printf '%q ' "${ORIG[@]}"
      printf '\n'
    } >&9
  } 9>> "$AUDIT" 2>/dev/null
}

die() { emit_metadata || true; printf 'secrets-exec: %s\n' "$*" >&2; exit 1; }

# Policy refusals: record best-effort, then exit non-zero. (Failing closed IS the
# outcome here, so an unwritable audit log must not turn a refusal into an allow.)
refuse() {
  emit_metadata || { printf 'secrets-exec: metadata serialization failed\n' >&2; exit 1; }
  printf 'secrets-exec: %s\n' "$*" >&2
  audit refused "reason=$(printf '%q' "$*")"
  exit 2
}

# ── arguments ─────────────────────────────────────────────────────────────────
ORIG=("$@")
case "${1:-}" in --list|-l) name=list ;; *) name="${1:-none}" ;; esac
[ "$_invalid_call_id" = 0 ] || refuse 'invalid internal call ID'
[ "$#" -ge 1 ] || die "usage: secrets-exec <consumer> [args...]   |   secrets-exec --list"

if [ "$1" = "--list" ] || [ "$1" = "-l" ]; then
  [ -f "$CONF" ] || die "no registry at $CONF"
  emit_metadata || die 'metadata serialization failed'
  printf 'registered consumers (bundle / key / injected as):\n'
  while IFS='|' read -r n b k e c; do
    case "$n" in ''|\#*) continue ;; esac
    printf '  %-12s %s / %s -> %s   [%s]\n' "$n" "$b" "$k" "$e" "$c"
  done < "$CONF"
  exit 0
fi

name="$1"; shift

# The name is matched as a plain string against the first registry field, never as a pattern,
# so a caller cannot select rows (or comment lines) with regex or separator characters.
[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || refuse "invalid consumer name $(printf '%q' "$name")"
[ -f "$CONF" ] || refuse "no registry at $CONF — nothing is allowed by default (fail closed)"
line="$(awk -F'|' -v n="$name" '("x" $1) == ("x" n) { print; exit }' "$CONF")"
[ -n "$line" ] || refuse "unknown consumer '$name'. Registered: $(grep -vE '^(#|$)' "$CONF" | cut -d'|' -f1 | tr '\n' ' ')"

IFS='|' read -r _cname bundle keypat envvar cmd guard <<<"$line"
[ -n "${bundle:-}" ] && [ -n "${keypat:-}" ] && [ -n "${envvar:-}" ] && [ -n "${cmd:-}" ] \
  || refuse "malformed registry row for '$name'"

# The command must be an absolute path: a bare name would be resolved through PATH,
# which reintroduces exactly the indirection this wrapper exists to remove.
case "$cmd" in
  /*=*) refuse "registry row for '$name' has a command containing '=' ('$cmd')" ;;
  /*) ;;
  *) refuse "registry row for '$name' has a non-absolute command ('$cmd'). Use an absolute path." ;;
esac

# ── optional secondary guard (weak; see the registry header) ──────────────────
# Order-INSENSITIVE and case-insensitive: every word of a guarded phrase must appear
# somewhere in the arguments. A contiguous-substring match would catch `gh auth token`
# but miss `gh auth --hostname github.com token`. Word matching closes that specific
# hole. It remains a secondary guard: the real control is not registering a program
# that can print its own credential.
if [ -n "${guard:-}" ]; then
  lower_args=" $(printf '%s' "$*" | tr '[:upper:]' '[:lower:]') "
  IFS=',' read -r -a _guard <<<"$guard"
  for g in "${_guard[@]}"; do
    # trim
    g="${g#"${g%%[![:space:]]*}"}"; g="${g%"${g##*[![:space:]]}"}"
    [ -n "$g" ] || continue

    # ── flag guard: PREFIX match, not whole-word ──────────────────────────────
    # A phrase beginning with '-' is treated as a FORBIDDEN ARGUMENT PREFIX.
    # Whole-word matching is unsound for flags: `--config=/tmp/x`, `-c=/tmp/x` and
    # `-c/tmp/x` are all accepted by ordinary argument parsers and none of them contains
    # the literal word `--config`. A client config file may redirect the injected token
    # to a caller-chosen host without any `://` in the arguments, bypassing a URL filter.
    # Prefix matching also fails closed:
    # a false positive refuses a legitimate flag rather than allowing a redirect.
    # A single-letter short flag (-c) is also caught inside a combined short-option
    # cluster (-vc/tmp/x): getopt-style parsers read that as -v -c /tmp/x.
    _short=""; case "$g" in -[!-]) _short="${g#-}" ;; esac
    case "$g" in
      -*)
        for a in "$@"; do
          if [ -n "$_short" ]; then
            case "$a" in
              --*) ;;
              -*"$_short"*) refuse "the argument '$a' carries the guarded short flag '$g' inside a combined short-option cluster for consumer '$name': it can point the client at a caller-chosen endpoint (or file), which exfiltrates the injected credential. Run the command without it, or ask the registry owner to change $CONF." ;;
            esac
          fi
          case "$a" in
            "$g"*) refuse "the argument '$a' matches the guarded flag prefix '$g' for consumer '$name': it can point the client at a caller-chosen endpoint (or file), which exfiltrates the injected credential. Run the command without it, or ask the registry owner to change $CONF." ;;
          esac
        done
        continue
        ;;
    esac

    all_present=1
    IFS=' ' read -r -a _words <<<"$(printf '%s' "$g" | tr '[:upper:]' '[:lower:]')"
    for w in "${_words[@]}"; do
      case "$lower_args" in
        *" $w "*) ;;
        *) all_present=0; break ;;
      esac
    done
    [ "$all_present" -eq 1 ] && refuse "the argument phrase '$g' is guarded for consumer '$name' because it makes the program emit its own credential. Edit $CONF only if that is wrong."
  done
fi

# ── multi-key rows ──────────────────────────────────────────────────────────
# A row may inject several values: the key and envvar columns are then '+'-separated
# lists of the SAME length, e.g.  BITGET_API_KEY+BITGET_API_SECRET+BITGET_PASSPHRASE.
# Rules are stricter than single-key rows, because a multi-key row is new surface:
#   - every key and envvar name is an exact UPPER_SNAKE name (no wildcards, no quotes);
#   - the bundle name is a plain token (it is interpolated into the remote command);
#   - envvars may not shadow the loader/shell hooks below, and may not repeat;
#   - every value is fetched separately; ANY failed or empty fetch refuses the whole call
#     and the program is never run with a partial credential set (fail closed).
# The audit line records every key NAME (key=A+B+C); values are never logged.
# Single-key rows (no '+') also get the reserved-envvar check and `ssh -n` (stdin is
# left to the consumer). Reserved envvar names (reserved_env, defined next to the
# PATH pin) are refused for EVERY row. A secret exported under one of these names would change
# HOW the consumer runs (loader/shell hooks, proxies, TLS roots and key logs, locale and
# libc tunables, config dirs, temp dirs, git/Go runtime knobs, interpreter search paths)
# rather than what it authenticates with; the JAVA*/NODE* option vars additionally ECHO
# their value to stderr. No registered row uses any of these names.

# Inherited variables that change how a program runs (reserved_env, incl. exported bash
# functions) are removed from every program this engine starts: the ssh fetch and the
# consumer. Only the NAMES go to /usr/bin/env -u; values never enter an argument list.
scrub=(-u BASH_ENV)
while IFS= read -r -d '' _e; do
  _n="${_e%%=*}"
  case "$_n" in PATH|HOME) continue ;; esac
  reserved_env "$_n" && scrub+=(-u "$_n")
done < <(/usr/bin/env -0)
unset _e _n

multi=0
case "$keypat$envvar" in *+*) multi=1 ;; esac
if [ "$multi" -eq 1 ]; then
  [[ "$bundle" =~ ^[A-Za-z0-9_-]+$ ]] || refuse "multi-key row for '$name' has an invalid bundle name"
  _mk_rx='^[A-Z_][A-Z0-9_]*(\+[A-Z_][A-Z0-9_]*)+$'
  [[ "$keypat" =~ $_mk_rx ]] || refuse "multi-key row for '$name': the key column must be exact UPPER_SNAKE names joined by '+' (no wildcards, no empty or trailing entries)"
  [[ "$envvar" =~ $_mk_rx ]] || refuse "multi-key row for '$name': the envvar column must be exact UPPER_SNAKE names joined by '+' (no empty or trailing entries)"
  IFS='+' read -r -a mkeys <<<"$keypat"
  IFS='+' read -r -a menvs <<<"$envvar"
  [ "${#mkeys[@]}" -ge 2 ] && [ "${#mkeys[@]}" -eq "${#menvs[@]}" ] \
    || refuse "multi-key row for '$name' needs the same number (>=2) of keys and envvars (${#mkeys[@]} keys, ${#menvs[@]} envvars)"
  _seen=" "
  for i in "${!mkeys[@]}"; do
    [[ "${mkeys[$i]}" =~ ^[A-Z_][A-Z0-9_]*$ ]] || refuse "multi-key row for '$name': key name #$((i+1)) is not an exact UPPER_SNAKE name (wildcards are not allowed in multi-key rows)"
    [[ "${menvs[$i]}" =~ ^[A-Z_][A-Z0-9_]*$ ]] || refuse "multi-key row for '$name': envvar name #$((i+1)) is not an exact UPPER_SNAKE name"
    reserved_env "${menvs[$i]}" && refuse "multi-key row for '$name': envvar '${menvs[$i]}' is reserved (it would change how the consumer runs, not what it authenticates with)"
    case "$_seen" in *" ${menvs[$i]} "*) refuse "multi-key row for '$name': envvar '${menvs[$i]}' appears twice" ;; esac
    _seen="$_seen${menvs[$i]} "
  done
else
  reserved_env "$envvar" && refuse "registry row for '$name': envvar '$envvar' is reserved (it would change how the consumer runs, not what it authenticates with)"
fi

# ── resolve the key ───────────────────────────────────────────────────────────
# An exact key name is used as-is; a pattern containing '*' is resolved against the
# bundle's key NAME list (values are never read). Ambiguity fails closed and reports
# candidate NAMES only.
key="$keypat"
if [ "$multi" -eq 0 ] && [[ "$keypat" == *"*"* ]]; then
  load_backend
  names="$(/usr/bin/env "${scrub[@]}" ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$REMOTE" "$(remote_cmd "$LIST_T" "$bundle")")"
  ls_rc=$?
  # Check exit status as well as output: a partial listing with a nonzero ssh status
  # is a transport failure, not permission to fetch a matching credential.
  [ "$ls_rc" -eq 0 ] || refuse "could not list keys for bundle '$bundle' on $REMOTE (ssh rc=$ls_rc)"
  [ -n "$names" ] || refuse "empty key listing for bundle '$bundle' (bundle name wrong?)"
  # A key-list command may emit a header line and indent names. Keep only key-shaped tokens,
  # or the header counts as a match and every glob looks ambiguous.
  names="$(printf '%s\n' "$names" | sed 's/^[[:space:]]*//' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$')"
  [ -n "$names" ] || refuse "no key names parsed from bundle '$bundle' (raw output was not in the expected shape)"
  rx="^${keypat//\*/.*}$"
  matches="$(printf '%s\n' "$names" | grep -Ei "$rx" || true)"
  nmatches="$(printf '%s' "$matches" | grep -c . || true)"
  if [ "$nmatches" -eq 0 ]; then
    refuse "no key in bundle '$bundle' matched '$keypat'. Key names present: $(printf '%s' "$names" | tr '\n' ' ')"
  elif [ "$nmatches" -gt 1 ]; then
    refuse "'$keypat' is ambiguous in bundle '$bundle' ($nmatches matches: $(printf '%s' "$matches" | tr '\n' ' ')) — set an exact key in $CONF"
  fi
  key="$matches"
fi

# ── refuse programs that could simply print the injected value ────────────────
# The whole guarantee is "the child consumes the credential without echoing it". That
# holds for purpose-built clients and collapses instantly for an interpreter: `env`,
# `printenv`, `bash -c`, or `awk 'BEGIN{print ENVIRON[...]}'` all turn this wrapper into
# a vault reader. Fail closed on the registry row rather than trusting whoever wrote it.
#
# This checks the BASENAME, so it cannot vouch for what the registered program actually
# does — a script with an innocuous name can still print its environment. It exists to
# catch the obvious mistake, not to certify the command.
bin="$(basename "$cmd")"
case "$bin" in
  sh|bash|zsh|dash|ksh|ash|fish|csh|tcsh|env|printenv|set|export|eval|exec|source|\
  python|python2|python3|perl|ruby|node|deno|bun|php|lua|tclsh|awk|gawk|mawk|nawk|\
  xargs|osascript|expect|script|socat|nc|netcat|ncat)
    refuse "refusing to run '$bin' as a consumer command: it is an interpreter or general-purpose tool that can print the injected value. Register a purpose-built client, or a reviewed script under ~/.config/secrets-exec/consumers.d/." ;;
esac

# ── default-deny caller-supplied URLs ─────────────────────────────────────────
# The exfil class that no guard and no command blocklist catches: a consumer that injects
# the credential into a request whose DESTINATION the caller chose. Point it at an attacker
# host and the secret walks out in a header. A consumer that needs a URL must be a reviewed
# script under consumers.d/ with its own fixed host and typed arguments — never a raw
# URL passthrough.
for a in "$@"; do
  case "$a" in
    *://*) refuse "refusing argument '$a': caller-supplied URLs are denied by default, because a consumer that injects the credential into a caller-chosen destination is an exfiltration path." ;;
  esac
done

# ── fetch the value (never printed, never on disk) ─────────────────────────────
# Bundle and key names are inserted into a remote command line: plain tokens only.
[[ "$bundle" =~ ^[A-Za-z0-9_.-]+$ ]] || refuse "registry row for '$name' has an invalid bundle name"
[ "$multi" -eq 1 ] || [[ "$key" =~ ^[A-Za-z0-9_.-]+$ ]] || refuse "registry row for '$name' has an invalid key name"
load_backend
# All policy and backend checks have passed. This names the selection, not success.
_metadata_bundle="$bundle"
_metadata_keys="$key"
emit_metadata || die 'metadata serialization failed'
if [ "$multi" -eq 1 ]; then
  # One fetch per key, same transport as single-key rows. Any failure refuses the whole
  # call before anything runs; no partial credential set is ever exported.
  mvals=()
  for i in "${!mkeys[@]}"; do
    _v="$(/usr/bin/env "${scrub[@]}" ssh -n -o BatchMode=yes -o ConnectTimeout=15 "$REMOTE" "$(remote_cmd "$GET_T" "$bundle" "${mkeys[$i]}")" 2>/dev/null)"
    rc=$?
    [ "$rc" -eq 0 ] || refuse "fetch failed for $bundle/${mkeys[$i]} (ssh rc=$rc); multi-key call refused, nothing was run"
    [ -n "$_v" ] || refuse "fetch returned an empty value for $bundle/${mkeys[$i]}; multi-key call refused, nothing was run"
    mvals+=("$_v")
  done
  unset _v
else
val="$(/usr/bin/env "${scrub[@]}" ssh -n -o BatchMode=yes -o ConnectTimeout=15 "$REMOTE" "$(remote_cmd "$GET_T" "$bundle" "$key")" 2>/dev/null)"
rc=$?
[ "$rc" -eq 0 ] || refuse "fetch failed for $bundle/$key (ssh rc=$rc)"
[ -n "$val" ] || refuse "fetch returned an empty value for $bundle/$key"
fi

# ── audit the permitted action BEFORE running it; fail closed if it cannot be recorded
if ! audit allowed "bundle=$bundle" "key=$key" "cmd=$(printf '%q' "$cmd")"; then
  die "refusing to run: the audit record could not be written to $AUDIT, and an unlogged secret use is not acceptable (fail closed)."
fi

# ── run the registered command with the secret ────────────────────────────────
# The value is EXPORTED, not passed as an argument. `env -i VAR=val cmd` would put
# the secret in /usr/bin/env's argv, readable from the process table.
#
# HOME is pinned to AGENT_HOME (derived from this script's own path) rather than inherited,
# so a caller-supplied HOME cannot redirect a consumer's default configuration file.
# For example, `curl --config -` still reads `$HOME/.curlrc` unless `-q` comes first.
#
# Inherited variables that change HOW a program runs (shell options and hooks, exported
# functions, loader, proxy, TLS/CA/key-log, interpreter options: reserved_env) are removed
# with `env -u NAME` (names only, never values). Without this, `SHELLOPTS=xtrace` or an
# exported `printf` function made a bash consumer print the credential. Ordinary variables
# are still inherited; `env -i VAR=val` stays rejected because it puts the value in argv.
unset BASH_ENV ENV CDPATH GLOBIGNORE
export HOME="$AGENT_HOME"
if [ "$multi" -eq 1 ]; then
  for i in "${!menvs[@]}"; do export "${menvs[$i]}=${mvals[$i]}"; done
  unset mvals
else
export "$envvar=$val"
fi

/usr/bin/env "${scrub[@]}" "$cmd" "$@"
rc=$?

# Record the outcome of the run itself. The pre-execution record cannot say whether the
# command succeeded, failed or crashed, which is the difference between an audit trail and
# a note that something was attempted.
audit exit "rc=$rc" || true
exit "$rc"
