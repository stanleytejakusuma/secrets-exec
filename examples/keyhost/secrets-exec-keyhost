#!/bin/bash -p
# Restricted SSH endpoint. Install options belong in authorized_keys, not requests.
set -euo pipefail
umask 077
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH LC_ALL=C

die() { printf 'secrets-exec-keyhost: %s\n' "$1" >&2; exit 1; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9_-][A-Za-z0-9_.-]*$ ]]; }
store="${HOME:?}/.local/share/secrets-exec-keyhost/store"
allow=''; log=''
while (( $# )); do
  (( $# >= 2 )) || die 'options require a value'
  case "$1" in
    --store) store="$2" ;;
    --allow) [[ -z "$allow" ]] || die 'duplicate allowlist'; allow="$2" ;;
    --log) log="$2" ;;
    *) die 'unknown option' ;;
  esac
  shift 2
done
[[ -n "$allow" && "$allow" != *$'\n'* && "$allow" != ,* && "$allow" != *, && "$allow" != *,,* ]] || die 'explicit allowlist required'
IFS=, read -r -a allowed <<< "$allow"
for name in "${allowed[@]}"; do valid_name "$name" || die 'invalid allowlist'; done

# Exact spaces and single quotes are part of this protocol. Never execute the text.
get_rx="^get '([A-Za-z0-9_-][A-Za-z0-9_.-]*)' '([A-Za-z0-9_-][A-Za-z0-9_.-]*)'$"
list_rx="^list '([A-Za-z0-9_-][A-Za-z0-9_.-]*)'$"
request="${SSH_ORIGINAL_COMMAND:-}"
key=''
if [[ "$request" =~ $get_rx ]]; then
  action='get'; bundle="${BASH_REMATCH[1]}"; key="${BASH_REMATCH[2]}"
elif [[ "$request" =~ $list_rx ]]; then
  action='list'; bundle="${BASH_REMATCH[1]}"
else
  die 'invalid request'
fi
permitted=0
for name in "${allowed[@]}"; do [[ "$bundle" != "$name" ]] || permitted=1; done
(( permitted )) || die 'bundle not allowed'

# Reject symlinks in every ancestor, including the administrator-selected store.
# The account and its directories are trusted; this is not race-proof against
# another process with write access as that same account (see the guide).
no_symlinks() {
  local path="$1" part current=''
  [[ "$path" == /* && "$path" != *$'\n'* ]] || die 'paths must be absolute and newline-free'
  local -a parts
  IFS=/ read -r -a parts <<< "$path"
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || continue
    [[ "$part" != . && "$part" != .. ]] || die 'dot path component refused'
    current+="/$part"
    [[ ! -L "$current" ]] || die 'symlink refused'
  done
}
private_dir() {
  local metadata owner mode
  [[ -d "$1" ]] || die 'store directory missing'
  metadata="$(stat -c '%u %a' -- "$1")" || die 'cannot inspect directory'
  read -r owner mode <<< "$metadata"
  [[ "$owner" == "$EUID" ]] && (( (8#$mode & 0022) == 0 )) || die 'unsafe directory owner or permissions'
}
private_file() {
  local metadata owner mode
  [[ -f "$1" && ! -L "$1" ]] || die 'not a regular private file'
  metadata="$(stat -Lc '%u %a' -- "$1")" || die 'cannot inspect file'
  read -r owner mode <<< "$metadata"
  [[ "$owner" == "$EUID" ]] && (( (8#$mode & 0077) == 0 )) || die 'unsafe file owner or permissions'
}
no_symlinks "$store"
private_dir "$store"
no_symlinks "$store/$bundle"
private_dir "$store/$bundle"
if [[ -n "$log" ]]; then
  no_symlinks "$log"
  if [[ -e "$log" ]]; then private_file "$log"; fi
  # Log only parsed names, never original input, options, errors or values.
  printf '%s %s%s\n' "$action" "$bundle" "${key:+ $key}" >> "$log" || die 'request log failed'
fi
if [[ "$action" == list ]]; then
  shopt -s nullglob dotglob
  keys=()
  for file in "$store/$bundle/"*; do
    name="${file##*/}"
    valid_name "$name" || die 'invalid key filename'
    private_file "$file"
    keys+=("$name")
  done
  # Validate everything before emitting anything, so refusal cannot return a partial list.
  if (( ${#keys[@]} )); then printf '%s\n' "${keys[@]}"; fi
else
  file="$store/$bundle/$key"
  private_file "$file"
  exec {fd}< "$file"
  # Check the opened object too. /proc is required on this Linux reference host.
  [[ -f "/proc/self/fd/$fd" ]] || die 'opened value is not regular'
  metadata="$(stat -Lc '%u %a' -- "/proc/$$/fd/$fd")" || die 'cannot inspect opened value'
  read -r owner mode <<< "$metadata"
  [[ "$owner" == "$EUID" ]] && (( (8#$mode & 0077) == 0 )) || die 'unsafe opened value'
  value=''
  # Bash cannot store NUL. read -d '' detects it rather than silently dropping it;
  # unlike command substitution, this preserves trailing newlines for validation.
  if IFS= read -r -d '' value <&"$fd"; then die 'NUL in value'; fi
  exec {fd}<&-
  [[ -n "$value" ]] || die 'empty value'
  [[ "$value" != *$'\n\n' ]] || die 'multiple trailing newlines in value'
  printf '%s' "$value"
fi
